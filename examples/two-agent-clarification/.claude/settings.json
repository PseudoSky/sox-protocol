{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "tools/sox-hooks/post_tool_use.sh"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "tools/sox-hooks/stop.sh"
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "tools/sox-hooks/stop.sh"
      }
    ]
  },
  "mcpServers": {
    "sox": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "sox_protocol.core.mcp_server"],
      "env": {
        "SOX_BACKING_STORE": "sqlite:///.sox/messages.db",
        "SOX_AGENT_ID_SOURCE": "env:CLAUDE_AGENT_NAME"
      }
    }
  }
}
