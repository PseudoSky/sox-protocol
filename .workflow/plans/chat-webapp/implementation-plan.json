  "feature_flags": {
    "graph_view": "force-directed agent/message graph; gate behind flag (VITE_SOX_FLAGS=graph_view or ?flags=graph_view)",
    "replay_mode": "history scrubber; gate until replay API is shipped (VITE_SOX_FLAGS=replay_mode or ?flags=replay_mode)"
  },
  "cli_subcommand": {
    "name": "sox ui",
    "behavior": "Pick a free localhost port, start the SOX HTTP transport with permissive localhost CORS, mount built static assets from sox_protocol.ui_assets at /ui/, then open the user's default browser to http://127.0.0.1:<port>/ui/. Flags: --port, --no-browser, --host, --token."
  },
  "test_plan": [
    "Vitest unit suite across src/sdk, src/state, src/hooks, src/lib with 100% coverage (rendering glue in components/ excluded with documented justification in coverage config).",
    "Mock SDK harness: in-memory fake implementing send/recv/watch/list_channels/ack/replay so hooks can be tested without an HTTP server.",
    "Negative tests: nack toast, connection drop reconnect, pending state reconcile when late ack arrives.",
    "Static analysis: tsc --noEmit --strict; eslint --max-warnings=0; grep ': any' returns empty.",
    "Build: pnpm build emits dist/ <= 250KB gzipped (size-limit script in package.json).",
    "Lighthouse: lhci autorun against `pnpm preview` build — perf >= 80, a11y >= 95.",
    "Python: `python -m sox_protocol.cli ui --help` exits 0; integration smoke launches server on ephemeral port and curls /ui/index.html for HTTP 200.",
    "watch() invariant: regex test asserts no setInterval/setTimeout-driven polling in src/sdk and src/hooks."
  ],
  "risks": [
    {"risk": "static + CORS", "mitigation": "HTTP transport advertises permissive CORS for localhost dev; document explicit allow-list config for non-localhost origins per webapp-deployment-model.md consequences."},
    {"risk": "auth in browser", "mitigation": "credential entered on connect, stored in sessionStorage only (never localStorage); cleared on tab close; README warns against exposing without reverse proxy."},
    {"risk": "bundle size creep", "mitigation": "size-limit budget 250KB gzipped enforced in CI; tree-shake SDK; lazy-load GraphView and ReplayScrubber behind flags."},
    {"risk": "watch() reconnect storms", "mitigation": "exponential backoff + jitter inside startWatch; UI surface via Toaster."},
    {"risk": "Python wheel ships stale assets", "mitigation": "CI orchestrates pnpm --filter @sox-protocol/ui build then copies dist/ -> ui_assets/ before pip wheel; ui_assets/.gitkeep keeps directory; build script verifies index.html exists pre-package."},
    {"risk": "feature flag leakage to prod", "mitigation": "flags default off; URL ?flags= overrides only in dev/preview builds gated by import.meta.env.DEV unless explicitly allowed."}
  ],
  "dependencies": [
    "react@^18", "react-dom@^18", "zustand@^4", "@sox-protocol/typescript (workspace SDK)",
    "tailwindcss@^3", "postcss", "autoprefixer",
    "vite@^5", "@vitejs/plugin-react", "typescript@^5",
    "vitest@^1", "@testing-library/react", "@testing-library/jest-dom", "jsdom",
    "eslint", "@typescript-eslint/parser", "@typescript-eslint/eslint-plugin", "eslint-plugin-react-hooks",
    "@lhci/cli", "size-limit", "@size-limit/preset-app"
  ],
  "build_order": [
    "1. Scaffold packages/ui workspace (package.json, tsconfig, vite.config, tailwind, eslint).",
    "2. Define src/types and src/sdk/client wrapping @sox-protocol/typescript.",
    "3. Implement src/state/store + selectors + feature-flags.",
    "4. Implement src/sdk/watch driving store from SDK async iterators.",
    "5. Implement hooks (useChannels, useMessages, useAgents, useSend, useAck, useReplay).",
    "6. Implement components in dependency order: ConnectionGate -> ChannelSidebar -> MessageThread -> AgentPanel -> ComposeBar -> ErrorBoundary/Toaster -> flagged GraphView/ReplayScrubber.",
    "7. Compose App.tsx and main.tsx; wire styles.",
    "8. Author tests in test/ matching plan.test_plan.",
    "9. Run tsc/eslint/vitest/build/lhci; tune until exit_signals pass.",
    "10. Implement packages/python/src/sox_protocol/ui_assets/ resource module + .gitkeep.",
    "11. Implement sox_protocol/cli/ui.py subcommand and wire into __main__.py argparse.",
    "12. Add CI/build hook to copy packages/ui/dist/ -> packages/python/src/sox_protocol/ui_assets/ before wheel build."
  ],
  "exit_signals": [
    "tsc --strict clean",
    "100% coverage on logic (excluding pure rendering)",
    "Lighthouse performance >= 80, a11y >= 95",
    "Static bundle deployable",
    "sox ui CLI works end-to-end"
  ]
}
