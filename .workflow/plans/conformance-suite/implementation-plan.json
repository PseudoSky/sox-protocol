      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "spec_ref": {"type": "string", "description": "spec/<file>.md#section reference"},
        "description": {"type": "string"},
        "pending": {"type": "boolean", "default": false, "description": "If true, runner skips in --strict mode"},
        "fixture_type": {"type": "string", "enum": ["happy", "failure", "boundary"]},
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string"},
              "credential": {"type": "string"}
            }
          }
        },
        "server_config": {
          "type": "object",
          "description": "Optional per-fixture server overrides applied via runner --config-override",
          "properties": {
            "backpressure_mode": {"type": "string", "enum": ["advisory", "enforced"]},
            "queue_limit": {"type": "integer"},
            "idempotency_ttl_ms": {"type": "integer"},
            "supported_versions": {"type": "array", "items": {"type": "string"}},
            "fault_inject": {"type": "string", "enum": ["store_unavailable", "internal_error", "rate_limited"]},
            "typed_channels": {
              "type": "object",
              "additionalProperties": {"type": "object", "description": "JSON Schema for the channel body"}
            }
          }
        },
        "setup": {
          "type": "array",
          "items": {"$ref": "#/$defs/step"}
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/step"}
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": true
          }
        }
      },
      "$defs": {
        "step": {
          "oneOf": [
            {
              "type": "object",
              "required": ["id", "operation"],
              "properties": {
                "id": {"type": "string"},
                "as_agent": {"type": "string"},
                "as_client_version": {"type": "string", "description": "For version-negotiation fixtures"},
                "operation": {
                  "type": "string",
                  "enum": ["send", "recv", "subscribe", "unsubscribe", "list_channels", "list_agents", "channels_ack", "channels_heartbeat", "replay", "group_create", "group_invite", "group_join", "group_leave", "group_list_members", "channels_collect"]
                },
                "input": {"type": "object"},
                "expected_output": {"type": "object"},
                "expected_error": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message_contains": {"type": "string"}
                  }
                }
              }
            },
            {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": {"type": "string"},
                "type": {"type": "string", "enum": ["sleep"]},
                "milliseconds": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    }
