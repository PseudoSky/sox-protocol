{
  "name": "04-concurrent-writers",
  "description": "N concurrent senders, single receiver. No loss, no duplication. The runner sends messages from multiple agents in rapid succession and verifies all arrive.",
  "agents": {
    "senders": ["agent-w1", "agent-w2", "agent-w3", "agent-w4", "agent-w5"],
    "receiver": "agent-reader"
  },
  "concurrency": {
    "writers": 5,
    "messages_per_writer": 4,
    "total_expected": 20
  },
  "setup": [
    {
      "agent": "agent-reader",
      "tool": "channels__subscribe",
      "args": { "pattern": "task:concurrent-04" },
      "expect": { "subscribed": { "type": "array" } }
    }
  ],
  "steps": [
    {
      "id": "send-w1-1",
      "agent": "agent-w1",
      "tool": "channels__send",
      "args": {
        "channel": "task:concurrent-04",
        "body": { "type": "status_update", "subject": "w1 msg 1", "writer": "w1", "seq": 1 }
      },
      "expect": { "sent_at": { "type": "number" }, "message_id": { "type": "string" } }
    },
    {
      "id": "send-w1-2",
      "agent": "agent-w1",
