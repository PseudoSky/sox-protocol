        "messages": { "type": "array" }
      }
    }
  ],
  "assertions": [
    {
      "type": "no_loss",
      "description": "All 20 messages from 5 writers must be received",
      "sent_count": 20,
      "recv_step": "recv-all",
      "min": 20
    },
    {
      "type": "no_duplication",
      "description": "message_id values must be unique across all received messages",
      "recv_step": "recv-all"
    },
    {
      "type": "all_writers_represented",
      "recv_step": "recv-all",
      "writers": ["w1", "w2", "w3", "w4", "w5"],
      "body_field": "writer",
      "description": "Messages from every writer must appear in recv output"
